{
  "name": "relay-pool-desktop",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --config vite.demo.config.ts --host 127.0.0.1",
    "build": "pnpm theme:audit && tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --config vite.demo.config.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/architecture/**/*.mjs\"",
    "test": "vitest run",
    "test:contracts": "node scripts/run-contract-tests.mjs",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "verify:persistence-artifacts": "node scripts/verify-persistence-v2-artifacts.mjs --tracked",
    "verify:release-bundle": "node scripts/verify-persistence-v2-artifacts.mjs --artifact src-tauri/target/x86_64-pc-windows-msvc/release/bundle",
    "audit:dead-code": "node scripts/dead-code-inventory.mjs",
    "test:dead-code-policy": "node scripts/dead-code-inventory-policy.test.mjs",
    "architecture:fixtures": "node scripts/architecture/check-fixtures.mjs",
    "architecture:typescript": "node scripts/architecture/check-typescript-boundaries.mjs",
    "architecture:commands": "node scripts/architecture/check-command-registry.mjs && node scripts/architecture/check-command-state-boundaries.mjs",
    "architecture:security": "node scripts/architecture/check-tauri-security.mjs && node scripts/architecture/check-build-entries.mjs",
    "architecture:artifacts": "node scripts/architecture/check-artifact-policy.mjs",
    "architecture:dependencies": "node scripts/architecture/check-dependency-lifecycle.mjs",
    "architecture:scale-baseline": "node scripts/architecture/scale-baseline/run.mjs",
    "generate:bindings": "node scripts/generate-bindings.mjs",
    "verify:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1 -Profile fast",
    "verify:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1 -Profile full",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1 -Profile release",
    "verify:release:prebundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1 -Profile release -ReleasePhase prebundle",
    "verify:release:postbundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1 -Profile release -ReleasePhase postbundle",
    "theme:audit": "node scripts/theme-audit.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.90.3",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "10.7.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.65.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.7.0"
}
